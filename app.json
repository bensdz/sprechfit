{
  "expo": {
    "name": "sprechfit-app",
    "slug": "sprechfit-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sprechfit.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/sprechfit.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.sprechfit.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ce4f7e7d-0016-4eda-a006-c30ab4598a68"
      }
    }
  }
}
